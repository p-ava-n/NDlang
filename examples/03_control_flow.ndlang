// if / else-if / else, for loops, and mutual recursion
// (is_even and is_odd call each other, so signatures must be collected first).
func is_even(n: int) -> bool {
    if n == 0 {
        return true;
    }
    return is_odd(n - 1);
}

func is_odd(n: int) -> bool {
    if n == 0 {
        return false;
    }
    return is_even(n - 1);
}

func classify(n: int) -> int {
    if n < 0 {
        return -1;
    } else if n == 0 {
        return 0;
    } else {
        return 1;
    }
}

func sum_to(n: int) -> int {
    let total: int = 0;
    for i in 1..n + 1 {
        total = total + i;
    }
    return total;
}

func main() -> int {
    print(is_even(10));        // true
    print(is_odd(10));         // false
    print(classify(-5));       // -1
    print(classify(0));        // 0
    print(classify(42));       // 1
    print(sum_to(100));        // 5050
    return 0;
}
